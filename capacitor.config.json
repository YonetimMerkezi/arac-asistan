{
  "appId": "com.sedat.smartdriveai",
  "appName": "Smart Drive AI",
  "webDir": "www",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0B0E14",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
